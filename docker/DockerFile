# CapScreen application image.
# Rebuild when CapScreen scripts/package change; reuse the base image.
# Tag the final image with CapScreen version, e.g. saei/capscreen:2.0.0-alpha.1
ARG BASE_IMAGE=ghcr.io/hassansaei/capscreen-base:latest
FROM ${BASE_IMAGE}

ARG USERNAME=appuser

USER root
COPY . /opt/capscreen/
WORKDIR /opt/capscreen

RUN /opt/conda/envs/capscreen/bin/pip install --no-cache-dir -e . && \
    /opt/conda/envs/capscreen-stat/bin/pip install --no-cache-dir -e . && \
    chown -R $USERNAME:$USERNAME /opt/capscreen

USER $USERNAME
ENTRYPOINT ["capscreen"]
