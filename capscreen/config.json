{
    "config_path": "/opt/capscreen/capscreen/config.json",
    "threads": 4,
    "log_level": "INFO",
    "reference": {
        "genome": "/opt/capscreen/reference/reference_aav2",
        "index_basename": "/opt/capscreen/reference/reference_aav2",
        "library": "/opt/capscreen/reference/library.csv"
    },
    "fastp": {
        "compression": 6,
        "length_required": 50,
        "dup_calc_accuracy": 3,
        "html_report": true,
        "json_report": true,
        "output_prefix": "fastp"
    },
    "pear": {
        "min_overlap": 10,
        "max_assembly_length": 1000,
        "min_assembly_length": 50,
        "quality_threshold": 15,
        "p_value": 0.01,
        "output_prefix": "pear"
    },
    "bowtie2": {
        "mode": "end-to-end",
        "sensitivity": "very-sensitive",
        "np": 0,
        "n_ceil": "L,0,0.9",
        "xeq": true,
        "N": 1,
        "reorder": true,
        "score_min": "L,-0.6,-0.6",
        "output_prefix": "aligned"
    },
    "samtools": {
        "sort_memory": "2G",
        "compression_level": 6
    },
    "flanking_sequences": {
        "flank_5p": "TTGAAAAGGTCATGATTACA",
        "flank_3p": "CAAGCAGCTACCGCAGATGT",
        "max_mismatches": 2,
        "primer_n": 1,
        "max_variable_nt": 120,
        "description": "Flanking sequences for variable region extraction. max_mismatches allows substitutions in both 5' and 3' flanks. primer_n is the degenerate N between each Illumina adapter (R1/R2) and the target-specific sequence. Inserts longer than max_variable_nt are checked for leftover inner flanks."
    },
    "output": {
        "create_subdirectories": true,
        "prefix": "processed_"
    },
    "html_template": "capscreen/templates/template_report.html",
    "show_count_matrix": true,
    "show_histogram": true,
    "keep_intermediate": false,
    "statistical_analysis": {
        "analysis": {
            "n_cpus": 8,
            "low_expression_threshold": 10,
            "pca": {
                "top_n_features": 500
            }
        },
        "differential_expression": {
            "min_replicates": 2,
            "min_count": 10,
            "drop_if_any_group_low": false,
            "log2rpm_pseudocount": 1,
            "adjust_batch": true
        },
        "enrichment_enhancement": {
            "er_cut": 3,
            "eh_cut": 3,
            "min_rpm": 5,
            "n_top": 20,
            "pseudocount": 1
        },
        "plots": {
            "dpi": {
                "standard": 300
            },
            "figure_sizes": {
                "pca": [7.5, 6.5]
            },
            "pca": {
                "point_size": 120,
                "fontsize": 10
            }
        }
    }
}
